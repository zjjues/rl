      "use_action_mask": false,
      "policy_mode": "direct",
      "safety_filter_mode": "none"
    },
    {
      "key": "ippo",
      "algorithm": "ippo",
      "critic_mode": "local",
      "intent_source": "none",
      "intent_profile_decoder": "none",
      "disable_intent_reward": true,
      "use_action_mask": false,
      "policy_mode": "direct",
      "safety_filter_mode": "none"
    },
    {
      "key": "happo",
      "algorithm": "happo",
      "critic_mode": "mlp",
