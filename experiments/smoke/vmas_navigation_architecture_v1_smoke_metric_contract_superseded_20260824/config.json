{
  "schema_version": 1,
  "study_id": "vmas_navigation_architecture_v1_smoke",
  "level": "smoke",
  "objective": "Pipeline validation on VMAS navigation; no language, UAV objective, action-mask, safety-filter, or preference claim.",
  "seeds": [
    7
  ],
