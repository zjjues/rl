{
  "schema_version": 1,
  "study_id": "uav_matd3_smoke_v1",
  "level": "smoke",
  "objective": "Exercise true MATD3 replay, twin critics, target smoothing, delayed actor updates, and hidden-intent evaluation.",
  "seeds": [
    7
  ],
  "bootstrap_seed": 20260801,
  "environment": {
    "name": "uav-scheduling-v0",
    "n_agents": 4,
    "n_targets": 4,
    "safety_reward_coef": 1.0,
    "task_reward_coef": 1.2,
    "intent_reward_profiles_enabled": true
  },
  "training": {
    "episodes": 10,
    "steps": 20,
    "rollout_length": 64,
    "minibatch_size": 64,
    "eval_interval": 10,
    "actor_lr": 0.0003,
    "critic_lr": 0.0003,
    "replay_capacity": 10000,
    "matd3_warmup_steps": 20,
    "matd3_exploration_noise": 0.1,
    "matd3_policy_noise": 0.2,
    "matd3_noise_clip": 0.5,
    "matd3_policy_delay": 2,
    "matd3_tau": 0.005,
    "device": "cpu"
  },
  "intent": {
    "dim": 25,
    "encoder_model": "sentence-transformers/all-MiniLM-L6-v2",
    "encoder_revision": "1110a243fdf4706b3f48f1d95db1a4f5529b4d41",
    "projection_seed": 17,
    "code_seed": 29
  },
  "treatment_key": "matd3",
  "variants": [
    {
      "key": "matd3",
      "intent_source": "onehot",
      "algorithm": "matd3",
      "critic_mode": "twin_q",
      "use_action_mask": false
    }
  ],
  "generalization": {
    "suite": "configs/research/uav_intent_generalization_suite.v1.json"
  },
  "evaluation": {
    "episodes": 2,
    "risk_tiers": {
      "easy": {
        "spawn_region_scale": 0.42,
        "spawn_separation_scale": 0.92,
        "intent_mode": "standard"
      },
      "hard": {
        "spawn_region_scale": 0.33,
        "spawn_separation_scale": 0.8,
        "intent_mode": "dense"
      }
    }
  }
}
