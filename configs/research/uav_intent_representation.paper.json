{
  "schema_version": 1,
  "study_id": "uav_intent_representation_v1",
  "level": "paper",
  "objective": "Test whether pretrained semantic intent geometry improves UAV safety-efficiency trade-offs over identity and random-code controls under fixed named intents.",
  "seeds": [7, 11, 23, 42, 100, 137, 211, 307, 401, 509],
  "bootstrap_seed": 20260801,
  "environment": {
    "name": "uav-scheduling-v0",
    "n_agents": 8,
    "n_targets": 6,
    "safety_reward_coef": 1.0,
    "task_reward_coef": 1.2,
    "intent_reward_profiles_enabled": true
  },
  "training": {
    "episodes": 3000,
    "steps": 50,
    "rollout_length": 128,
    "minibatch_size": 64,
    "eval_interval": 100,
    "actor_lr": 0.0003,
    "critic_lr": 0.0003,
    "eta": 0.5,
    "eta_end": 0.1,
    "potential_update_mode": "normal",
    "device": "cpu"
  },
  "intent": {
    "dim": 64,
    "encoder_model": "sentence-transformers/all-MiniLM-L6-v2",
    "encoder_revision": "1110a243fdf4706b3f48f1d95db1a4f5529b4d41",
    "projection_seed": 17,
    "code_seed": 29
  },
  "variants": [
    {"key": "pretrained_semantic", "intent_source": "pretrained_semantic", "algorithm": "imappo", "critic_mode": "attention", "use_action_mask": true},
    {"key": "random_dense", "intent_source": "random_dense", "algorithm": "imappo", "critic_mode": "attention", "use_action_mask": true},
    {"key": "legacy_hash", "intent_source": "legacy_hash", "algorithm": "imappo", "critic_mode": "attention", "use_action_mask": true},
    {"key": "onehot", "intent_source": "onehot", "intent_dim": 25, "algorithm": "imappo", "critic_mode": "attention", "use_action_mask": true},
    {"key": "mappo", "intent_source": "onehot", "algorithm": "mappo", "critic_mode": "uniform", "use_action_mask": false},
    {"key": "ippo", "intent_source": "onehot", "algorithm": "ippo", "critic_mode": "local", "use_action_mask": false},
    {"key": "rule_planner", "intent_source": "onehot", "algorithm": "rule_planner", "critic_mode": "rule", "use_action_mask": false},
    {"key": "no_masking", "intent_source": "pretrained_semantic", "algorithm": "imappo", "critic_mode": "attention", "use_action_mask": false},
    {"key": "no_intent_reward", "intent_source": "pretrained_semantic", "algorithm": "imappo", "critic_mode": "attention", "use_action_mask": true, "disable_intent_reward": true},
    {"key": "no_attention", "intent_source": "pretrained_semantic", "algorithm": "imappo", "critic_mode": "mlp", "use_action_mask": true}
  ],
  "evaluation": {
    "episodes": 100,
    "risk_tiers": {
      "easy": {"spawn_region_scale": 0.42, "spawn_separation_scale": 0.92, "intent_mode": "standard"},
      "medium": {"spawn_region_scale": 0.37, "spawn_separation_scale": 0.86, "intent_mode": "dense"},
      "hard": {"spawn_region_scale": 0.33, "spawn_separation_scale": 0.80, "intent_mode": "dense"}
    }
  }
}
