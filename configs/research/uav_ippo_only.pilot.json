{
  "schema_version": 1,
  "study_id": "uav_imappo_main",
  "level": "pilot",
  "objective": "IPPO baseline: independent PPO (no shared critic).",
  "seeds": [
    7,
    11,
    23,
    42,
    100,
    256,
    512,
    1024,
    2048,
    4096
  ],
