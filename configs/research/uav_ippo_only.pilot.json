    "encoder_model": "sentence-transformers/all-MiniLM-L6-v2",
    "encoder_revision": "",
    "projection_seed": 17,
    "code_seed": 29
  },
  "variants": [
    {
      "key": "ippo",
      "intent_source": "onehot",
      "algorithm": "ippo",
